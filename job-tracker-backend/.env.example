# Job Tracker Backend
NODE_ENV=development
PORT=4000

# PostgreSQL — replace with your own connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobtracker?schema=public"

# JWT
JWT_SECRET="replace-with-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Optional: real AI understanding for the "Analyze link" feature.
# Leave unset to use the built-in offline parser (no key needed).
# Any OpenAI-compatible API works. Free options:
#   Groq (free tier):  AI_BASE_URL="https://api.groq.com/openai/v1"  AI_MODEL="llama-3.1-8b-instant"
#   Ollama (local):    AI_BASE_URL="http://localhost:11434/v1"       AI_MODEL="llama3.1"  AI_API_KEY="ollama"
#   OpenRouter:        AI_BASE_URL="https://openrouter.ai/api/v1"    AI_MODEL="<any-model>"
# AI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
